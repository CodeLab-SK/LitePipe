<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.YoutubeLite" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">?attr/colorSurfaceVariant</item>
        <item name="colorOnSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="colorSecondaryContainer">?attr/colorSurfaceVariant</item>
        <item name="colorOnSecondaryContainer">?attr/colorOnSurfaceVariant</item>


        <item name="colorTertiary">?attr/colorSecondary</item>
        <item name="colorOnTertiary">?attr/colorOnSecondary</item>
        <item name="colorTertiaryContainer">?attr/colorSecondaryContainer</item>
        <item name="colorOnTertiaryContainer">?attr/colorOnSecondaryContainer</item>
        <item name="tint">@android:color/transparent</item>

        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:colorBackground">?attr/colorSurface</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">?attr/colorOutline</item>

        <item name="colorSurfaceContainer">?attr/colorSurface</item>
        <item name="colorSurfaceContainerLow">?attr/colorSurface</item>
        <item name="colorSurfaceContainerHigh">?attr/colorSurfaceVariant</item>
        <item name="colorSurfaceContainerHighest">?attr/colorSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">?attr/colorSurface</item>

        <item name="materialAlertDialogTheme">@style/Theme.YoutubeLite.AlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.YoutubeLite.BottomSheetDialog</item>

        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.YoutubeLite" parent="Base.Theme.YoutubeLite" />

    <style name="Theme.YoutubeLite.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.YoutubeLite</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.YoutubeLite.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.YoutubeLite.Dialog</item>
        <item name="tint">@android:color/transparent</item>
    </style>

    <style name="Theme.YoutubeLite.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="bottomSheetStyle">@style/Widget.YoutubeLite.BottomSheet</item>
        <item name="tint">@android:color/transparent</item>
    </style>

    <style name="Widget.YoutubeLite.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.YoutubeLite.BottomSheet</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ShapeAppearance.YoutubeLite.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.YoutubeLite.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="AppCard" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:layout_marginVertical">6dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="AppCardItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="drawableTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="AboutCard" parent="AppCard" />
    <style name="AboutItem" parent="AppCardItem" />

    <style name="Theme.Transparent" parent="Theme.YoutubeLite">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

</resources>